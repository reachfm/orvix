# /etc/orvix/external-backup.env — mode 0600 root:root
# PLACEHOLDERS ONLY. Do NOT commit a filled-in copy.
#
# See docs/backup/hetzner-object-storage-restic.md for the full procedure.

# Hetzner S3-compatible endpoint. LOCATION is one of fsn1, nbg1, hel1.
RESTIC_REPOSITORY=s3:<LOCATION>.your-objectstorage.com/<BUCKET>

# Path to the file that contains ONLY the Restic repository password.
# Create it out-of-band: `openssl rand -base64 32 > /etc/orvix/restic-password
# && chmod 400 /etc/orvix/restic-password && chown root:root /etc/orvix/restic-password`.
RESTIC_PASSWORD_FILE=/etc/orvix/restic-password

# Bucket-scoped S3 credentials generated in the Hetzner Cloud Console under
# "S3 credentials". Do NOT reuse your project-wide API token here.
AWS_ACCESS_KEY_ID=<KEY_ID>
AWS_SECRET_ACCESS_KEY=<SECRET>
AWS_DEFAULT_REGION=<REGION>
